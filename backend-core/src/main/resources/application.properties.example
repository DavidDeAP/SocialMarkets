# ===================================================================
# CONFIGURACIÓN DE SOCIALMARKETS (BACKEND)
# ===================================================================

# 1. Configuración de la Aplicación
spring.application.name=backend-core

# 2. Base de Datos (PostgreSQL)
# Asegúrate de crear la base de datos 'socialmarkets' antes de arrancar
spring.datasource.url=jdbc:postgresql://localhost:5432/socialmarkets
spring.datasource.username=tu_usuario
spring.datasource.password=tu_contraseña
spring.datasource.driver-class-name=org.postgresql.Driver

# 3. Configuración de Hibernate/JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

# 4. Amazon Web Services (AWS S3)
# Necesario para el almacenamiento de imágenes de perfil y posts
aws.s3.access-key=TU_AWS_ACCESS_KEY
aws.s3.secret-key=TU_AWS_SECRET_KEY
# Solo necesario si usas credenciales temporales de AWS Academy
aws.s3.session-token=TU_AWS_SESSION_TOKEN
aws.s3.region=us-east-1
aws.s3.bucket-name=nombre-de-tu-bucket

# 5. Seguridad y JWT
# Clave secreta para firmar los tokens de sesión (mínimo 32 caracteres recomendados)
app.jwt.secret=tu_clave_secreta_para_firmar_tokens_jwt_segura